# Copy this to .env.local for local testing and into Vercel project env vars for prod.

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Override the demo model. Keep as Sonnet for now; consider Haiku later for cost.
MAYA_MODEL=claude-sonnet-4-5

# --- Upstash Redis (REST) ----------------------------------------------------
# Both values come from the Upstash console -> your DB -> "REST API" tab.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# --- Twilio ------------------------------------------------------------------
# Only TWILIO_AUTH_TOKEN is required for inbound signature verification.
TWILIO_AUTH_TOKEN=your_twilio_auth_token
